# Template only. Place in .github/workflows/demo-pages.yml in the destination repo.
# This assumes the demo is committed under static-demo/ and Pages is available.
name: Publish Sobi static demo
on:
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: static-demo
      - name: Deploy
        id: deployment
        uses: actions/deploy-pages@v4
